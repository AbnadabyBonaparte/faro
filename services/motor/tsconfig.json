{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],

    // O motor é RODADO direto de `src` por `node --experimental-strip-types`
    // (é o batch de madrugada, não uma biblioteca importada). O strip-only
    // apenas remove tipos: não reescreve extensão, então o import precisa
    // apontar para o arquivo que existe de verdade — o `.ts`.
    // `rewriteRelativeImportExtensions` faz o `tsc` emitir `.js` no build,
    // então os dois modos funcionam com UM só jeito de escrever import.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
