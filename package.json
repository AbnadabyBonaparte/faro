{
  "name": "faro",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:guards": "pnpm --filter @faro/tools guards",
    "verify": "pnpm typecheck && pnpm build && pnpm db:guards"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
